labels <- paste(c("Unemployed", "Employed"), pct, "%")
pie(
counts,
labels = labels,
col = c("skyblue", "orange"),
main = "Employment Status"
)
counts <- table(accs_clean$immigrant_binary)
pct<- round(counts / sum(counts) * 100, 1)
labels <- paste(c("Non-Immigrant", "Immigrant"), pct, "%")
pie(
counts,
labels = labels,
col = c("purple", "green"),
)
pie(
counts,
labels = labels,
col = c("purple", "green"),
main = "Generation Status"
)
summary(as_reg)
