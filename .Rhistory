accs_res <- read_excel("~/Desktop/M.S. Thesis/acculturative stress survey.xlsx")
View(accs_res)
# taking out participants who didn't meet criteria
table(accs_res$sq_1)
table(accs_res$dem_2)
accs_res<- accs_res %>%
mutate(latino_include = ifelse(
sq_1 == "Yes" | dem_2 == "Hispanic, Latino or Spanish origin",
1,0
))
table(accs_res$latino_include)
accs_clean<- accs_res %>%
filter(latino_include == 1)
View(accs_clean)
# taking out row 56 because they don't answer the questions correctly
accs_clean <- accs_clean[-56, ]
# recoding the critical reflection and critical efficacy subscales
ccs_items<- paste0("ccs_", 1:13)
accs_clean[ccs_items] <- lapply(accs_clean[ccs_items], function(x) {
recode(x,
"Strongly disagree" = 1,
"Mostly disagree" = 2,
"Slightly disagree" = 3,
"Slightly agree" = 4,
"Mostly agree" = 5,
"Strongly agree" = 6
)
})
# recoding the critical action subscale
ccsaction_items<- paste0("ccs_", 14:22)
accs_clean[ccsaction_items] <- lapply(accs_clean[ccsaction_items], function(x) {
recode(x,
"Never did this" = 1,
"Once or twice last year" = 2,
"Once every few months" = 3,
"At least once a month" = 4,
"At least once a week" = 5
)
})
#Checking to see if the recoding worked
str(accs_clean[, paste0("ccs_", 1:22)])
# reverse coding item 9
accs_clean$ccs_9<- 7 - accs_clean$ccs_9
# creating subscale for ccs
reflection_items<- paste0("ccs_", 1:8)
efficacy_items<- paste0("ccs_", 9:13)
action_items<- paste0("ccs_", 14:22)
# recoding the acculturation stress scale
acstress_items<- paste0("as_", 1:21)
accs_clean[acstress_items] <- lapply(accs_clean[acstress_items], function(x) {
recode(x,
"Not stressful" = 1,
"Somewhat stressful" = 2,
"Stressful" = 3,
"Very stressful" = 4,
"Extremely stressful" = 5
)
})
char_rows<- which(!is.na(accs_clean$dem_1) & is.na(as.numeric(accs_clean$dem_1)))
char_rows
accs_clean$dem_1[char_rows] <- as.numeric(str_extract(accs_clean$dem_1[char_rows], "[0-9]+"))
accs_clean$dem_1<- as.numeric(accs_clean$dem_1)
# looking at the descriptive statistics for the age column
mean(accs_clean$dem_1, na.rm = TRUE)
describe(accs_clean$dem_1)
accs_clean$dem_11[accs_clean$dem_11 == "Prefer not to say"] <- NA
table(accs_clean$dem_11)
accs_clean$employment_binary <- ifelse(
accs_clean$dem_11 == "Not currently employed",
"Unemployed",
"Employed"
)
accs_clean$employment_binary <- as.factor(accs_clean$employment_binary)
table(accs_clean$employment_binary)
accs_clean$dem_14[accs_clean$dem_14 %in%
c("Don't know", "Prefer not to say", "N/A")] <- NA
table(accs_clean$dem_14)
accs_clean$dem_14[accs_clean$dem_14 %in%
c("Moderately religious, Very religious",
"Slightly religious, Moderately religious")] <- NA
table(accs_clean$dem_14)
accs_clean$dem_14 <- recode(
accs_clean$dem_14,
"Not religious" = 1,
"Slightly religious" = 2,
"Moderately religious" = 3,
"Very religious" = 4
)
accs_clean$dem_14 <- as.numeric(accs_clean$dem_14)
table(accs_clean$dem_14)
# Trying to calculate the Acculturation stress scale scores
safe_items<- accs_clean[paste0("as_", 1:21)]
accs_clean$acc_stress_total<- rowMeans(safe_items, na.rm = TRUE)
summary(accs_clean$acc_stress_total)
describe(accs_clean$acc_stress_total)
ggplot(accs_clean, aes(x = acc_stress_total)) +
geom_histogram(bins = 20) +
labs(
title = "Distribution of Acculturation Stress Scores",
x = "Acculturation Stress Score",
y = "Frequency"
)
accs_clean$ccs_reflection<- rowMeans(accs_clean[, reflection_items], na.rm = TRUE)
accs_clean$ccs_efficacy<- rowMeans(accs_clean[, efficacy_items], na.rm = TRUE)
accs_clean$ccs_action<- rowMeans(accs_clean[, action_items], na.rm = TRUE)
describe(accs_clean$ccs_reflection)
describe(accs_clean$ccs_efficacy)
describe(accs_clean$ccs_action)
table(accs_clean$employment_binary)
prop.table(table(accs_clean$employment_binary))
prop.table(table(accs_clean$employment_binary))*100
table(accs_clean$dem_14)
prop.table(table(accs_clean$employment_binary))
prop.table(table(accs_clean$dem_14))
prop.table(table(accs_clean$dem_14)) * 100
accs_clean$dem_10 <- recode(accs_clean$dem_10,
"Immigrant to the United States at age of 14 or older" = "Immigrated 14+",
"Immigrated to the United States before the age of 14" = "Immigrated <14",
"1st generation immigrant (born in the United States to immigrant parents)" = "1st gen US-born (immigrant parents)",
"2nd generation immigrant (born in the United States same as parents; grandparents born abroad)" = "2nd gen")
accs_clean$dem_10 <- as.factor(accs_clean$dem_10)
table(accs_clean$dem_10)
prop.table(table(accs_clean$dem_10))
prop.table(table(accs_clean$dem_10)) * 100
table(accs_clean$dem_10)
accs_clean$dem_10[accs_clean$dem_10 ==
"1st generation immigrant (born in the United States to immigrant parents), 2nd generation immigrant (born in the United States same as parents; grandparents born abroad"] <- NA
accs_clean$dem_10[accs_clean$dem_10 ==
"1st generation immigrant (born in the United States to immigrant parents), 2nd generation immigrant (born in the United States same as parents; grandparents born abroad"] <- NA
accs_clean$dem_10[accs_clean$dem_10 ==
"1st generation immigrant (born in the United States to immigrant parents), 2nd generation immigrant (born in the United States same as parents; grandparents born abroad"] <- NA
accs_clean$dem_10[accs_clean$dem_10 ==
"1st generation immigrant (born in the United States to immigrant parents), 2nd generation immigrant (born in the United States same as parents; grandparents born abroad)"] <- NA
accs_clean$immigrant_simple <- recode(accs_clean$dem_10,
"1st gen US-born (immigrant parents)" = "US-born",
"2nd gen" = "US-born",
"Immigrated <14" = "Immigrant",
"Immigrated 14+" = "Immigrant")
table(accs_clean$immigrant_simple)
unique(accs_clean$dem_10)
accs_clean$immigrant_simple <- ifelse(
accs_clean$dem_10 %in% c(
"1st gen US-born (immigrant parents)",
"2nd gen"
),
"US-born",
"Immigrant"
)
accs_clean$immigrant_simple <- as.factor(accs_clean$immigrant_simple)
table(accs_clean$immigrant_simple, useNA = "ifany")
prop.table(table(accs_clean$immigrant_simple)) * 100
summary(accs_clean)
table(accs_clean$employment_binary)
table(accs_clean$immigrant_simple)
# Looking at the reliability of the 2 scales
alpha(accs_clean[, c("reflection_items", "efficacy_items", "action_items")])
reflection_items<- paste0("ccs_", 1:8)
efficacy_items<- paste0("ccs_", 9:13)
action_items<- paste0("ccs_", 14:22)
# Looking at the reliability of the 2 scales
alpha(accs_clean[, c("reflection_items", "efficacy_items", "action_items")])
# Running the independent t-tests
t.test(acc_stress_total ~ employment_binary, data = accs_clean)
t.test(acc_stress_total ~ immigrant_simple, data = accs_clean)
# Running the correlations
cor.test(accs_clean$dem_14, accs_clean$acc_stress_total)
# Running correlation for each subscale
cor.test(accs_clean$ccs_reflection, accs_clean$acc_stress_total)
cor.test(accs_clean$ccs_action, accs_clean$acc_stress_total)
cor.test(accs_clean$ccs_efficacy, accs_clean$acc_stress_total)
corr.test(accs_clean[, c(
"ccs_reflection",
"ccs_efficacy",
"ccs_action",
"acc_stress_total"
)])
# checking the scales for outliers, missing data, and approximate normality
hist(accs_clean$acc_stress_total)
# checking the scales for outliers, missing data, and approximate normality
boxplot(accs_clean$acc_stress_total)
# checking the scales for outliers, missing data, and approximate normality
shapiro.test(accs_clean$acc_stress_total)
# Running the correlations
cor.test(accs_clean$dem_14, accs_clean$acc_stress_total, method = "spearman")
# Running correlation for each subscale
cor.test(accs_clean$ccs_reflection, accs_clean$acc_stress_total, method = "spearman")
cor.test(accs_clean$ccs_action, accs_clean$acc_stress_total, method = "spearman")
cor.test(accs_clean$ccs_efficacy, accs_clean$acc_stress_total, method = "spearman")
# Running the independent t-tests
t.test(acc_stress_total ~ employment_binary, data = accs_clean)
t.test(acc_stress_total ~ immigrant_simple, data = accs_clean)
